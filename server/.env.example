DEBUG=True
SECRET_KEY=django-insecure-greenroots-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

CLIENT_URL=http://localhost:5173

# Must be a Web application OAuth 2.0 Client ID from Google Cloud Console.
# Placeholder values like "demo" cause Google Error 401: invalid_client.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback/

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
